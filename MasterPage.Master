                        </li>
                    </ul>
                </div>
            </div>
        </nav>


        <!-- Farmer Navigation Bar (Shown When Logged In) -->
        <nav id="farmerNav" runat="server" class="navbar navbar-expand-lg navbar-dark fixed-top" visible="false">
