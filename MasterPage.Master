                    <a href="Profile.aspx" class="nav-link" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Profile">
                        <i class="fas fa-user-circle fa-2x text-white me-3"></i>
                    </a>
                    <a href="Home.aspx" class="nav-link" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Logout">
                        <i class="fas fa-sign-out-alt fa-2x text-danger"></i>
                    </a>
                </div>
            </div>
        </nav>

        <!-- Distributor Navigation Bar (Shown When Logged In) -->
        <nav id="DistributorNav" runat="server" class="navbar navbar-expand-lg navbar-dark fixed-top" visible="false">
            <div class="container-fluid">
                <!-- Logo and Title -->
                <a class="navbar-brand d-flex align-items-center" href="Home.aspx">
                    <img src="Images/organic.png" alt="Organic Food" class="me-2">
                    <span class="text-white fw-bold fs-4">Organic Food Traceability System</span>
                </a>

                <!-- Navigation Links (Products, Orders, Change Password) -->
                <div class="nav-buttons">
