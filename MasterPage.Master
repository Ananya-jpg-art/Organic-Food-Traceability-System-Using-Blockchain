                    <a class="btn btn-custom text-white" href="ChangePassword.aspx">Change Password</a>
                </div>

                <!-- Profile & Logout Icons -->
                <div class="profile-logout-icons">
                    <a href="Profile.aspx" class="nav-link" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Profile">
                        <i class="fas fa-user-circle fa-2x text-white me-3"></i>
                    </a>
                    <a href="Home.aspx" class="nav-link" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Logout">
                        <i class="fas fa-sign-out-alt fa-2x text-danger"></i>
                    </a>
                </div>
            </div>
        </nav>

        <!-- Manufacture Navigation Bar (Shown When Logged In) -->
        <nav id="ManufactureNav" runat="server" class="navbar navbar-expand-lg navbar-dark fixed-top" visible="false">
            <div class="container-fluid">
